APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://news:change-me@db:5432/news
SOURCES_CONFIG_PATH=/app/config/sources.yaml
READY_CHECK_DATABASE=true


# Optional GitHub API credential (environment only)
GITHUB_TOKEN=

# Phase 3: external AI stays disabled until explicitly configured.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL_FACTS=
AI_SELECTOR_MODEL=
AI_WRITER_MODEL=
AI_VERIFIER_MODEL=
AI_REQUIRE_DISTINCT_MODELS=true
REVIEW_REQUIRED=false
REVIEW_REQUIRE_FOUR_EYES=true

# Draft export: uploader connection settings belong to the separate WPuploader project.
DRAFT_EXPORT_ENABLED=true
# Empty uses a local user-data directory, never the NAS source directory.
DRAFT_ARTIFACT_DIR=
# Optional shared transfer root; empty keeps completed drafts local.
DRAFT_TRANSFER_DIR=
DRAFT_PRODUCER_ID=

# Automatic comparison research within approved, registered collection sources.
# Minimum distinct article URLs, including the main article.
COMPARISON_MIN_SOURCES=3
COMPARISON_AUTO_RESEARCH=true
# Missing-source search, fetch and refresh require explicit opt-in.
FETCH_MISSING_SOURCES=false
RESEARCH_MAX_CANDIDATES=100
RESEARCH_MAX_FACT_CHECKS=6
RESEARCH_MAX_SOURCES_PER_ATTEMPT=6
RESEARCH_MAX_ATTEMPTS=3
RESEARCH_RETRY_SECONDS=60

# Generate an original conceptual illustration for each completed article.
FEATURED_IMAGES_ENABLED=true
AI_IMAGE_MODEL=gpt-image-1.5
AI_IMAGE_QUALITY=medium
AI_IMAGE_SIZE=1536x1024

# Explicit comparison shadow evaluation. It does not enable automatic semantic research.
# Setting this to shadow blocks all WordPress publication operations.
COMPARISON_SELECTION_MODE=legacy
AI_COMPARISON_PLANNER_MODEL=
AI_COMPARISON_ASSESSOR_MODEL=
AI_COMPARISON_VERIFIER_MODEL=
COMPARISON_MIN_PRODUCTS=3
COMPARISON_MAX_EVALUATIONS=8

# Category-led PR TIMES pair discovery (explicit CLI; audit only).
AI_PAIR_KEYWORD_MAX_INPUT_CHARS=200000
AI_PAIR_KEYWORD_MAX_OUTPUT_TOKENS=16000
AI_EMBEDDING_MODEL=
AI_EMBEDDING_REVISION=v1

# Standalone Discovery search vocabulary. Empty model falls back to the comparison planner.
AI_DISCOVERY_VOCABULARY_MODEL=
AI_DISCOVERY_VOCABULARY_MAX_INPUT_CHARS=200000
AI_DISCOVERY_VOCABULARY_MAX_OUTPUT_TOKENS=16000
