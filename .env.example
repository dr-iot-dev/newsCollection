APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://news:change-me@db:5432/news
SOURCES_CONFIG_PATH=/app/config/sources.yaml
READY_CHECK_DATABASE=true


# Optional GitHub API credential (environment only)
GITHUB_TOKEN=

# Phase 3: external AI stays disabled until explicitly configured.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL_FACTS=
AI_SELECTOR_MODEL=
AI_WRITER_MODEL=
AI_VERIFIER_MODEL=
AI_REQUIRE_DISTINCT_MODELS=true
REVIEW_REQUIRED=false
REVIEW_REQUIRE_FOUR_EYES=true

# Phase 4: enable only after configuring a dedicated WordPress Application Password.
WORDPRESS_ENABLED=false
WORDPRESS_BASE_URL=https://wordpress.example
# Default: regular posts. For the included plugin, use nc_news / nc-news.
WORDPRESS_POST_TYPE=post
# Empty: posts for post, otherwise the post type's internal name.
WORDPRESS_REST_BASE=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
# Pre-existing WordPress taxonomy IDs, as JSON objects.
WORDPRESS_CATEGORY_MAP={}
WORDPRESS_TAG_MAP={}

# Automatic comparison research within approved, registered collection sources.
# Minimum distinct article URLs, including the main article.
COMPARISON_MIN_SOURCES=3
COMPARISON_AUTO_RESEARCH=true
RESEARCH_REFRESH_SOURCES=true
RESEARCH_MAX_CANDIDATES=100
RESEARCH_MAX_FACT_CHECKS=6
RESEARCH_MAX_SOURCES_PER_ATTEMPT=6
RESEARCH_MAX_ATTEMPTS=3
RESEARCH_RETRY_SECONDS=60

# Generate an original conceptual illustration for each WordPress draft.
FEATURED_IMAGES_ENABLED=true
AI_IMAGE_MODEL=gpt-image-1.5
AI_IMAGE_QUALITY=medium
AI_IMAGE_SIZE=1536x1024
