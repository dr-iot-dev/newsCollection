{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "module": {
      "enum": [
        "collect",
        "ground",
        "curate",
        "write",
        "verify",
        "illustrate",
        "assemble"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "properties": {
        "fetch_missing_sources": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": true
    }
  }
}
