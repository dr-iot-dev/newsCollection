{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageResultV1",
  "type": "object",
  "required": [
    "schema_version",
    "job_key",
    "outcome",
    "outputs",
    "issues",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_key": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "success",
        "needs_input",
        "rejected",
        "error"
      ]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object"
    }
  }
}
